FORGE_DATABASE_URL=postgresql+psycopg://forge:forge-local@127.0.0.1:55432/forge
FORGE_DATA_DIR=.forge
# local binds API to loopback. Set oidc for a shared deployment; never expose local auth publicly.
FORGE_AUTH_MODE=local
FORGE_OIDC_ISSUER=
FORGE_OIDC_AUDIENCE=forgeagent
FORGE_OIDC_JWKS_URL=
FORGE_MODEL_PROVIDER=unconfigured
FORGE_MODEL_ID=
FORGE_MODEL_BASE_URL=
FORGE_MODEL_API_KEY=
# Prices in USD per million tokens; explicit price configuration required for real calls.
FORGE_INPUT_PRICE=0
FORGE_OUTPUT_PRICE=0
# Leave cache tariffs unset until the exact provider/model rates are configured.
# FORGE_CACHED_INPUT_PRICE=...
# FORGE_CACHE_WRITE_PRICE=...
FORGE_MODEL_PROTOCOL=responses
FORGE_MODEL_OUTPUT_MODE=native
FORGE_MODEL_TOKENIZER=o200k_base
FORGE_MODEL_TOKEN_COUNT=true
FORGE_MODEL_SUPPORTS_SCHEMA=true
FORGE_MODEL_SUPPORTS_TOOLS=true
FORGE_SANDBOX_IMAGE=forgeagent-sandbox:local
FORGE_SANDBOX_RUNTIME=runc
# All workers sharing the database must use the same provider/sandbox limits.
FORGE_WORKER_SLOTS=4
FORGE_PROVIDER_CONCURRENCY=2
FORGE_SANDBOX_CONCURRENCY=4
FORGE_S3_ENDPOINT=
FORGE_S3_BUCKET=forgeagent
FORGE_S3_ACCESS_KEY=
FORGE_S3_SECRET_KEY=
FORGE_S3_SESSION_TOKEN=
FORGE_OBJECT_SPOOL_BYTES=4194304
FORGE_S3_MULTIPART_BYTES=8388608
FORGE_REMOTE_HOSTS=
# Tenant/origin-bound secret references; configure values in deployment secret storage.
FORGE_REMOTE_CREDENTIALS={}
OTEL_EXPORTER_OTLP_ENDPOINT=
