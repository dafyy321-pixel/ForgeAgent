FORGE_DATABASE_URL=postgresql+psycopg://forge:forge-local@127.0.0.1:55432/forge
FORGE_DATA_DIR=.forge
# local binds API to loopback. Set oidc for a shared deployment; never expose local auth publicly.
FORGE_AUTH_MODE=local
FORGE_OIDC_ISSUER=
FORGE_OIDC_AUDIENCE=forgeagent
FORGE_OIDC_JWKS_URL=
FORGE_MODEL_PROVIDER=unconfigured
FORGE_MODEL_ID=
FORGE_MODEL_BASE_URL=
FORGE_MODEL_API_KEY=
# Prices in USD per million tokens; explicit price configuration required for real calls.
FORGE_INPUT_PRICE=0
FORGE_OUTPUT_PRICE=0
FORGE_SANDBOX_IMAGE=forgeagent-sandbox:local
FORGE_SANDBOX_RUNTIME=runc
FORGE_S3_ENDPOINT=
FORGE_S3_BUCKET=forgeagent
FORGE_S3_ACCESS_KEY=
FORGE_S3_SECRET_KEY=
FORGE_REMOTE_HOSTS=
FORGE_CALLBACK_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=

